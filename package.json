{
	"name": "ccusage-lib",
	"version": "0.0.0",
	"description": "Per-session API-price costs from a pinned ccusage binary.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/fdarian/ccusage-lib.git"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"build": "tsdown",
		"test": "bun test",
		"check:type": "tsc --noEmit",
		"check:lint": "biome check",
		"check": "pnpm run check:lint && pnpm run check:type && pnpm test && pnpm run build",
		"ci:version": "changeset version",
		"ci:release": "pnpm run build && changeset publish",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^2.31.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.3",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
